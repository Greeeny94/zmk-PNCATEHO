#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

// CONFIG
#define COMBO_TIMEOUT 70
#define COMBO_LAYERS 0
#define STICKY_TIMEOUT 500

// LEFT SIDE ONLY (10 клавиш)
#define TLP 0   // TOP LEFT PRIMARY
#define TLR 1   // TOP LEFT ROW
#define TLM 2   // TOP LEFT MIDDLE
#define TLI 3   // TOP LEFT INNER
#define BLP 4   // BOTTOM LEFT PRIMARY
#define BLR 5   // BOTTOM LEFT ROW
#define BLM 6   // BOTTOM LEFT MIDDLE
#define BLI 7   // BOTTOM LEFT INNER
#define LOT 8   // O-THUMB LEFT (Backspace)
#define LIT 9   // I-THUMB LEFT (Space)

&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
};

/ {
  combos {
    compatible = "zmk,combos";
    #include "chords.dtsi"
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &none &none &none &none
        &none &none &none &none
        &none &none
      >;
    };
  };
};
